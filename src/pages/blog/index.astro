---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkList from '../../components/LinkList.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, byDateDesc, sectionInfo, unique } from '../../lib/blog';

const posts = await getPosts();
const sections = unique(posts.map((p) => p.section)).map((section) => {
	const count = posts.filter((p) => p.section === section).length;
	const info = sectionInfo(section);
	return {
		href: `/blog/${section}/`,
		title: info.title,
		description: info.description,
		meta: `${count} ${count === 1 ? 'post' : 'posts'}`,
	};
});
const latest = posts.sort(byDateDesc).slice(0, 5);
---

<BaseLayout title="Blog" description="Notes on finance, software, AI infrastructure and performance.">
	<h1>Blog</h1>
	{sections.length > 0 ? <LinkList items={sections} /> : <p class="muted">Nothing here yet.</p>}

	{
		latest.length > 0 && (
			<>
				<h2>Latest</h2>
				<PostList posts={latest} showCategory />
			</>
		)
	}
</BaseLayout>
