---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { SITE } from '../../../../consts';
import { getPosts, bySeries, sectionInfo, categoryInfo } from '../../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => {
		const siblings = posts
			.filter((p) => p.section === post.section && p.category === post.category)
			.sort(bySeries);
		const i = siblings.findIndex((p) => p.id === post.id);
		return {
			params: { section: post.section, category: post.category, slug: post.slug },
			props: { post, prev: siblings[i - 1], next: siblings[i + 1] },
		};
	});
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const sec = sectionInfo(post.section);
const cat = categoryInfo(post.section, post.category);
// 1200px-wide JPEG of the post's own image if it has one, else the site default.
const ogImage = post.data.image
	? (await getImage({ src: post.data.image, width: 1200, format: 'jpeg' })).src
	: undefined;
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.date.toISOString(),
	dateModified: post.data.date.toISOString(),
	image: new URL(ogImage ?? SITE.ogImage, Astro.site).href,
	url,
	mainEntityOfPage: url,
	articleSection: cat.title,
	inLanguage: 'en',
	author: { '@type': 'Person', name: SITE.name, url: SITE.url },
	publisher: { '@type': 'Person', name: SITE.name, url: SITE.url },
};
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(
	post.data.date,
);
---

<BaseLayout
	title={`${post.data.title} (${cat.title})`}
	description={post.data.description}
	image={ogImage}
	imageAlt={post.data.image ? post.data.title : undefined}
	type="article"
	publishedTime={post.data.date}
	jsonLd={[jsonLd]}
>
	<Breadcrumbs
		items={[
			{ label: 'Blog', href: '/blog/' },
			{ label: sec.title, href: `/blog/${post.section}/` },
			{ label: cat.title, href: `/blog/${post.section}/${post.category}/` },
		]}
	/>
	<article>
		<h1>{post.data.title}</h1>
		<p class="muted"><time datetime={post.data.date.toISOString()}>{date}</time></p>
		<div class="prose">
			<Content />
		</div>
	</article>

	{
		(prev || next) && (
			<nav class="pager" aria-label="Series navigation">
				<span>{prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}</span>
				<span>{next && <a href={`/blog/${next.id}/`}>{next.data.title} →</a>}</span>
			</nav>
		)
	}
	<Lightbox />
</BaseLayout>

<style>
	.pager {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 64px;
		padding-top: 16px;
		border-top: 1px solid var(--rule);
	}
</style>
