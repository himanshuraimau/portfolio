---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, byDateDesc } from '../lib/blog';
import { SITE, LINKS } from '../consts';

const posts = (await getPosts()).sort(byDateDesc).slice(0, 5);

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		'@id': `${SITE.url}/#person`,
		name: SITE.name,
		url: SITE.url,
		jobTitle: SITE.jobTitle,
		description: SITE.description,
		worksFor: { '@type': 'Organization', name: SITE.employer },
		sameAs: LINKS.filter((l) => l.href.startsWith('http')).map((l) => l.href),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE.name,
		url: SITE.url,
		description: SITE.description,
		author: { '@id': `${SITE.url}/#person` },
	},
];
---

<BaseLayout jsonLd={jsonLd}>
	<h1>{SITE.name}</h1>
	<p>
		I'm a software engineer currently interning at Morgan Stanley. I'm interested in AI
		infrastructure and performance engineering.
	</p>
	<p>I like building reliable systems and making them faster.</p>

	<nav class="links" aria-label="Find me online">
		{
			LINKS.map((link) => (
				<a
					href={link.href}
					target={link.href.startsWith('http') ? '_blank' : undefined}
					rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	{
		posts.length > 0 && (
			<section>
				<h2>Latest writing</h2>
				<PostList posts={posts} showCategory />
				<p><a href="/blog/">Browse all sections →</a></p>
			</section>
		)
	}
</BaseLayout>
