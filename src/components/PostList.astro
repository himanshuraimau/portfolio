---
import type { Post } from '../lib/blog';
import { categoryInfo } from '../lib/blog';

interface Props {
	posts: Post[];
	showCategory?: boolean;
}

const { posts, showCategory = false } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' });
---

<ul>
	{
		posts.map((post) => (
			<li>
				<span>
					<a href={`/blog/${post.id}`}>{post.data.title}</a>
					{showCategory && (
						<span class="muted"> · {categoryInfo(post.section, post.category).title}</span>
					)}
				</span>
				<time class="muted" datetime={post.data.date.toISOString()}>
					{fmt.format(post.data.date)}
				</time>
			</li>
		))
	}
</ul>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 4px 16px;
		padding: 8px 0;
	}
</style>
