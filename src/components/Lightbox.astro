---
// Click any image inside a `.prose` block to open it full-size in a popup.
// Click the image again to toggle between "fit to screen" and "actual size".
// Click outside the image, press the × button or Esc to close.
---

<dialog id="lightbox" aria-label="Image preview">
	<button type="button" class="close" aria-label="Close">×</button>
	<div class="stage">
		<img id="lightbox-img" alt="" />
	</div>
</dialog>

<style>
	dialog {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(0, 0, 0, 0.88);
	}
	dialog:not([open]) {
		display: none;
	}
	.stage {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		overflow: auto;
		padding: 24px;
		box-sizing: border-box;
	}
	img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		background: #fff;
		border-radius: 4px;
		cursor: zoom-in;
	}
	img.zoomed {
		max-width: none;
		max-height: none;
		cursor: zoom-out;
	}
	.close {
		position: fixed;
		top: 12px;
		right: 16px;
		z-index: 1;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 28px;
		line-height: 1;
		cursor: pointer;
	}
	.close:hover,
	.close:focus-visible {
		background: rgba(255, 255, 255, 0.3);
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
	const big = document.querySelector<HTMLImageElement>('#lightbox-img');

	if (dialog && big) {
		const open = (src: HTMLImageElement) => {
			big.src = src.currentSrc || src.src;
			big.alt = src.alt;
			big.classList.remove('zoomed');
			dialog.showModal();
		};

		document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', `${img.alt || 'Image'} (click to enlarge)`);
			img.addEventListener('click', () => open(img));
			img.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open(img);
				}
			});
		});

		big.addEventListener('click', (e) => {
			e.stopPropagation();
			big.classList.toggle('zoomed');
		});

		// Clicking anywhere that is not the image (backdrop, padding, ×) closes it.
		dialog.addEventListener('click', () => dialog.close());
	}
</script>
