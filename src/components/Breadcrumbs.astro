---
interface Props {
	items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav class="muted" aria-label="Breadcrumb">
	{
		items.map((item, i) => (
			<>
				{i > 0 && <span aria-hidden="true"> / </span>}
				{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
			</>
		))
	}
</nav>

<style>
	nav {
		margin-bottom: 24px;
	}
	a {
		color: inherit;
	}
</style>
