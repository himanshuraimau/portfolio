---
import { NAV } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<header class="container">
	<nav aria-label="Primary">
		{
			NAV.map((item) => (
				<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>

	<button id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">
		<svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		</svg>
		<svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
		</svg>
	</button>
</header>

<style>
	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: clamp(32px, 8vh, 72px);
	}
	nav {
		display: flex;
		gap: 22px;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
		text-decoration: underline;
	}
	button {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid var(--rule);
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	button:hover,
	button:focus-visible {
		color: var(--text);
	}
	/* Show the icon for the theme you would switch to. */
	.sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: block;
	}
	:global(:root[data-theme='dark']) .moon {
		display: none;
	}
</style>

<script>
	const btn = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const root = document.documentElement;

	const sync = () => {
		const dark = root.dataset.theme === 'dark';
		btn?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
	};

	btn?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		sync();
	});

	// Follow system changes until the visitor picks a theme themselves.
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
		let saved = null;
		try {
			saved = localStorage.getItem('theme');
		} catch {}
		if (!saved) {
			root.dataset.theme = e.matches ? 'dark' : 'light';
			sync();
		}
	});

	sync();
</script>
